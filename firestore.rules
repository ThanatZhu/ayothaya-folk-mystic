rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function numberIn(n, lo, hi) { return n is number && n >= lo && n <= hi; }
  function validSave(d) {
   let s = d.state;
   let t = s.traveler;
   return d.keys().hasOnly(['revision','updatedAt','state','character','serverId'])
    && d.revision is int && d.revision > 0 && d.updatedAt == request.time
    && s.keys().hasOnly(['schema','mapId','traveler','position','settings'])
    && s.schema == 1
    && s.mapId in ['ayutthaya','bangsai','lavo','suphan','phitsanulok','nakhon','ayutthaya-wilds','bangsai-wilds','lavo-wilds','suphan-wilds','phitsanulok-wilds','nakhon-wilds']
    && t.keys().hasOnly(['version','hp','mp','kills','cooldowns']) && t.version == 5
    && numberIn(t.hp,0,140) && numberIn(t.mp,0,100)
    && t.kills is int && numberIn(t.kills,0,10000000)
    && t.cooldowns is list && t.cooldowns.size() == 10
    && numberIn(t.cooldowns[0],0,60) && numberIn(t.cooldowns[1],0,60)
    && numberIn(t.cooldowns[2],0,60) && numberIn(t.cooldowns[3],0,60)
    && numberIn(t.cooldowns[4],0,60) && numberIn(t.cooldowns[5],0,60)
    && numberIn(t.cooldowns[6],0,60) && numberIn(t.cooldowns[7],0,60)
    && numberIn(t.cooldowns[8],0,60) && numberIn(t.cooldowns[9],0,60)
    && s.position.keys().hasOnly(['x','z'])
    && numberIn(s.position.x,-125,125) && numberIn(s.position.z,-200,15)
    && s.settings.keys().hasOnly(['zoom','azimuth','motion'])
    && numberIn(s.settings.zoom,0.65,2.7) && numberIn(s.settings.azimuth,-7,7)
    && s.settings.motion is bool;
  }
  function validAppearance(a) {
   return a.keys().hasAll(['outfit','hair','hairColor','eyes','beard','tattoo','garment'])
    && a.keys().hasOnly(['outfit','hair','hairColor','eyes','beard','tattoo','garment'])
    && a.garment in ['original','shouldercloth','cloak']
    && a.outfit in ['original','indigo','crimson','ivory']
    && a.hair in ['original','topknot','braid']
    && a.hairColor in ['original','black','brown','silver']
    && a.eyes in ['original','brown','green','blue']
    && a.beard in ['none','mustache','goatee']
    && a.tattoo in ['none','forehead','arms'];
  }
  function validJob(c) {
   return c.jobId == '' || (
    (c.classId == 'swordsman' && c.jobId in ['guardian','duelist']) ||
    (c.classId == 'lancer' && c.jobId in ['vanguard','war-lancer']) ||
    (c.classId == 'hunter' && c.jobId in ['ranger','spirit-hunter']) ||
    (c.classId == 'boxer' && c.jobId in ['master-boxer','iron-boxer']) ||
    (c.classId == 'rogue' && c.jobId in ['shadow','assassin']) ||
    (c.classId == 'shaman' && c.jobId in ['spirit-master','yantra-master']) ||
    (c.classId == 'acolyte' && c.jobId in ['healer','warder'])
   );
  }
  function validCharacter() {
   let c = request.resource.data.character;
   return c.keys().hasOnly(['name','gender','classId','appearance','jobId'])
    && (!('appearance' in c) || validAppearance(c.appearance))
    && (!('jobId' in c) || validJob(c))
    && c.name is string && c.name.size() >= 2 && c.name.size() <= 32
    && c.gender in ['male','female'] && c.classId in ['novice','swordsman','lancer','hunter','boxer','rogue','shaman','acolyte'];
  }
  match /players/{uid}/saves/{slot} {
   function owner() { return request.auth != null && request.auth.uid == uid && slot in ['main','server-1','server-2']; }
   function migrated() {
    return (slot == 'server-1' && exists(/databases/$(database)/documents/players/$(uid)/characters/slot-1))
     || (slot == 'server-2' && exists(/databases/$(database)/documents/players/$(uid)/characters/slot-2));
   }
   allow get: if owner();
   allow create: if false;
   allow update: if owner() && !migrated() && slot != 'main'
    && validSave(request.resource.data) && validCharacter()
    && request.resource.data.revision == resource.data.revision + 1
    && request.resource.data.character == resource.data.character;

  }
  match /players/{uid}/characters/{slot} {
   function owner() { return request.auth != null && request.auth.uid == uid && slot in ['slot-1','slot-2','slot-3','slot-4','slot-5']; }
   function legacyServer() { return slot == 'slot-1' ? 'server-1' : 'server-2'; }
   function legacyExists() { return slot in ['slot-1','slot-2'] && exists(/databases/$(database)/documents/players/$(uid)/saves/$(legacyServer())); }
   function migration() {
    let old = get(/databases/$(database)/documents/players/$(uid)/saves/$(legacyServer())).data;
    let d = request.resource.data;
    return slot in ['slot-1','slot-2'] && d.serverId == legacyServer()
     && d.character == old.character && d.state == old.state && d.revision == old.revision;
   }
   function transitions() {
    let before = resource.data.character;
    let after = request.resource.data.character;
    let kills = resource.data.state.traveler.kills;
    let oldJob = before.get('jobId','');
    let newJob = after.get('jobId','');
    return after.name == before.name && after.gender == before.gender
     && (after.classId == before.classId || (before.classId == 'novice' && after.classId != 'novice' && kills >= 240 && newJob == ''))
     && (newJob == oldJob || (oldJob == '' && newJob != '' && after.classId == before.classId && kills >= 590));
   }
   allow get: if owner();
   allow create: if owner() && validSave(request.resource.data) && validCharacter()
    && request.resource.data.serverId in ['server-1','server-2']
    && ((legacyExists() && migration()) || (!legacyExists()
     && request.resource.data.revision == 1 && request.resource.data.character.classId == 'novice'
     && request.resource.data.character.get('jobId','') == ''
     && request.resource.data.state.traveler.kills == 0));
   allow update: if owner() && validSave(request.resource.data) && validCharacter()
    && request.resource.data.serverId == resource.data.serverId
    && request.resource.data.revision == resource.data.revision + 1 && transitions();
  }

 }
}
